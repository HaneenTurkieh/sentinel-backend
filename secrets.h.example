// secrets.h.example - TEMPLATE ONLY. Safe to commit to GitHub.
//
// To use: copy this file to "secrets.h" (same folder), then replace the
// placeholder values below with your real WiFi and backend credentials.
// secrets.h itself is listed in .gitignore and must NEVER be committed -
// only this .example file should ever go to GitHub.

#pragma once

#define SECRET_WIFI_SSID     "your-wifi-name"
#define SECRET_WIFI_PASSWORD "your-wifi-password"

// No trailing slash, e.g. "https://sentinel-backend.onrender.com"
#define SECRET_BACKEND_HOST  "https://your-backend.onrender.com"

// Must match DEVICE_API_KEY in the backend's .env / Render environment
// variables EXACTLY.
#define SECRET_DEVICE_API_KEY "your-device-api-key"
